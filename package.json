{
	"name": "log4js-appender-sentry",
	"version": "0.2.0",
	"description": "Sentry Appender for log4js-node",
	"keywords": [
		"logging",
		"log",
		"log4js",
		"log4js-node",
		"node",
		"sentry",
		"appender"
	],
	"homepage": "https://github.com/xseman/log4js-appender-sentry#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xseman/log4js-appender-sentry.git"
	},
	"funding": "https://github.com/sponsors/xseman",
	"license": "Apache-2.0",
	"author": "Filip Seman <filip.seman@pm.me>",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js",
			"require": "./lib/index.js"
		}
	},
	"types": "./lib/index.d.ts",
	"files": [
		"lib/**/*.js",
		"lib/**/*.d.ts",
		"!lib/**/*_test*"
	],
	"scripts": {
		"prebuild": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\"",
		"build": "tsc --build",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"typecheck": "tsc --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"test": "bun test ./src --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:watch": "bun test ./src --watch --coverage"
	},
	"dependencies": {
		"@sentry/node": "^11.8.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"dprint": "~0.64.1",
		"log4js": "^6.9.1",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"log4js": ">=6"
	}
}
